{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pao.task.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "workflow_id", "depends_on", "lwar_id", "instance_id", "generation", "registry_version", "goal", "instructions", "completion_criteria", "cwd", "timeout_s", "permissions", "max_retries", "priority", "attempt", "created_at"],
  "properties": {
    "schema_version": {"const": "pao.task.v1"},
    "task_id": {"type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "workflow_id": {"type": "string", "pattern": "^workflow-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "parent_task_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9._-]*$"}
      ]
    },
    "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "lwar_id": {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"},
    "instance_id": {"type": "string", "pattern": "^lwar-instance-[a-f0-9]{32}$"},
    "generation": {"type": "integer", "minimum": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "role": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "instructions": {"type": "string", "minLength": 1},
    "completion_criteria": {"type": "array", "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "input_files": {"type": "array", "items": {"type": "string"}},
    "expected_output": {"type": "string", "minLength": 1},
    "timeout_s": {"type": "integer", "minimum": 1},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "network"],
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "write": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "boolean"},
        "max_artifact_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "max_retries": {"type": "integer", "minimum": 0},
    "priority": {"type": "integer", "minimum": 0},
    "adapter_options": {"type": "object"},
    "attempt": {"type": "integer", "minimum": 1},
    "claim_token": {"type": "string", "pattern": "^claim-[a-f0-9]{32}$"},
    "execution_id": {"type": "string", "pattern": "^execution-[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
