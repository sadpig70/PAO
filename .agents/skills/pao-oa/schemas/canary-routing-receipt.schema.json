{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pao.canary-routing-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "decided_at",
    "task_id",
    "task_class",
    "profile_sha256",
    "policy_sha256",
    "observations_sha256",
    "circuit_state_sha256",
    "selected_lwar_id",
    "selected_instance_id",
    "selected_generation",
    "selected_registry_version",
    "incumbent_lwar_id",
    "candidate_lwar_id",
    "eligible_lwar_ids",
    "route_mode",
    "reason",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": "pao.canary-routing-receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^canary-routing-[a-f0-9]{32}$"},
    "decided_at": {"type": "string", "format": "date-time"},
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observations_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "circuit_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_lwar_id": {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"},
    "selected_instance_id": {
      "type": "string",
      "pattern": "^lwar-instance-[a-f0-9]{32}$"
    },
    "selected_generation": {"type": "integer", "minimum": 1},
    "selected_registry_version": {"type": "integer", "minimum": 1},
    "incumbent_lwar_id": {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"},
    "candidate_lwar_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"}
      ]
    },
    "eligible_lwar_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"}
    },
    "route_mode": {
      "enum": [
        "leader",
        "shadow",
        "recovery_shadow",
        "live",
        "circuit_open"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "class_stats", "global_stats", "confidence"],
      "properties": {
        "policy": {"type": "object"},
        "class_stats": {"type": "object"},
        "global_stats": {"type": "object"},
        "confidence": {"type": "object"}
      }
    }
  }
}
