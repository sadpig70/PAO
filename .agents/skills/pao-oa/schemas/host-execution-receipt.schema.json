{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pao.host-execution-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "task_id",
    "created_at",
    "status",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "pao.host-execution-receipt.v1"},
    "adapter_id": {"enum": ["qwen_code", "kimi_cli"]},
    "task_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["accepted", "rejected"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "runtime_version": {"type": "string"},
    "model_ids": {"type": "array", "items": {"type": "string"}},
    "output": {},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "tool_calls": {"type": "integer", "minimum": 0},
    "provider_calls": {"type": "integer", "minimum": 0},
    "session_id": {"type": ["string", "null"]},
    "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "error": {"type": "string"}
  }
}
