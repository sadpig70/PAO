{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pao.invocation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lwar_id",
    "instance_id",
    "generation",
    "invocation_id",
    "epoch",
    "pid",
    "started_at"
  ],
  "properties": {
    "schema_version": {"const": "pao.invocation.v1"},
    "lwar_id": {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"},
    "instance_id": {"type": "string", "pattern": "^lwar-instance-[a-f0-9]{32}$"},
    "generation": {"type": "integer", "minimum": 1},
    "invocation_id": {"type": "string", "pattern": "^invocation-[a-f0-9]{32}$"},
    "epoch": {"type": "integer", "minimum": 1},
    "pid": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"}
  }
}
