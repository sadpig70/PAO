{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pao.routing-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "observed_at",
    "task_id",
    "task_class",
    "lwar_id",
    "instance_id",
    "generation",
    "registry_version",
    "receipt_id",
    "route_mode",
    "accepted",
    "reported_tokens",
    "validation_sha256"
  ],
  "properties": {
    "schema_version": {"const": "pao.routing-observation.v1"},
    "observation_id": {
      "type": "string",
      "pattern": "^routing-observation-[a-f0-9]{32}$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "lwar_id": {"type": "string", "pattern": "^LWAR[1-9][0-9]*$"},
    "instance_id": {
      "type": "string",
      "pattern": "^lwar-instance-[a-f0-9]{32}$"
    },
    "generation": {"type": "integer", "minimum": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "receipt_id": {"type": "string", "pattern": "^canary-routing-[a-f0-9]{32}$"},
    "route_mode": {
      "enum": [
        "leader",
        "shadow",
        "recovery_shadow",
        "live",
        "circuit_open"
      ]
    },
    "accepted": {"type": "boolean"},
    "reported_tokens": {"type": "integer", "minimum": 0},
    "validation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
