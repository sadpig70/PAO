{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pao.result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "workflow_id",
    "lwar_id",
    "instance_id",
    "generation",
    "registry_version",
    "status",
    "summary",
    "evidence",
    "artifacts",
    "next_action",
    "exit_code",
    "attempt",
    "claim_token",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {"const": "pao.result.v1"},
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^workflow-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lwar_id": {
      "type": "string",
      "pattern": "^LWAR[1-9][0-9]*$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^lwar-instance-[a-f0-9]{32}$"
    },
    "generation": {"type": "integer", "minimum": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "interrupted",
        "timed_out",
        "protocol_error"
      ]
    },
    "summary": {"type": "string"},
    "evidence": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "snapshot"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "snapshot": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_action": {"type": "string", "minLength": 1},
    "exit_code": {"type": "integer"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "attempt": {"type": "integer", "minimum": 1},
    "claim_token": {
      "type": "string",
      "pattern": "^claim-[a-f0-9]{32}$"
    },
    "submitted_at": {"type": "string", "format": "date-time"}
  }
}
